<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS: run the estimator once a day.

  Why a LaunchAgent and not cron: the scraper drives a *visible* Chromium
  (DataDome blocks headless), so it needs the logged-in graphical session that
  cron does not have. And if the Mac is asleep at the scheduled time, launchd
  runs the job on wake — cron silently skips the slot and never catches up.

  Install:
    sed -e 's|/PATH/TO/REPO|'"$PWD"'|g' -e 's|PROFILE_NAME|Vannes-2|g' \
        deploy/com.rent-estimator.daily.plist \
        > ~/Library/LaunchAgents/com.rent-estimator.daily.plist
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.rent-estimator.daily.plist

  Run it now, without waiting for the schedule:
    launchctl kickstart -p gui/$UID/com.rent-estimator.daily

  Remove:
    launchctl bootout gui/$UID/com.rent-estimator.daily
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rent-estimator.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/REPO/.venv/bin/rent-estimator</string>
        <string>--profil</string>
        <string>PROFILE_NAME</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/PATH/TO/REPO</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Nothing watches the terminal on a scheduled run: a site changing its
         markup would otherwise fail in silence. The log is the only witness. -->
    <key>StandardOutPath</key>
    <string>/PATH/TO/REPO/output/run.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/REPO/output/run.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
